{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "nexus: start all",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "pnpm dev:api & pnpm dev --host 127.0.0.1 --port 5173"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "nexus"
      }
      ,
      "problemMatcher": {
        "owner": "custom",
        "pattern": [
          {
            "regexp": "."
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*dev:api.*|.*vite.*|.*VITE.*",
          "endsPattern": ".*http://127\\.0\\.0\\.1:5173/.*|.*Local:\\s+http://127\\.0\\.0\\.1:5173/.*"
        }
      }
    }
  ]
}
